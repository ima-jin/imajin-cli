# Core runtime configuration
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false

# imajin-ai connection (non-secret)
# Must include the /auth path segment, e.g. https://jin.imajin.ai/auth
IMAJIN_AI_BASE_URL=https://jin.imajin.ai/auth

# Authentication tokens should not be stored in this file.
# Use CLI auth/session commands (as implemented) and secure credential storage.
